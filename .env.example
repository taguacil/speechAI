# =============================================================================
# Azure Mode (speechai command)
# =============================================================================
# Azure Speech Service (from Azure AI Foundry)
AZURE_SPEECH_KEY=your_subscription_key_here
AZURE_SPEECH_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_TRANSLATOR_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_TRANSLATOR_KEY=your_subscription_key_here
# LiteLLM for sentiment analysis
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MODEL=azure/gpt-4o-mini
LITELLM_API_KEY=sk-1234

# =============================================================================
# Gemini Mode (speechai-gemini command)
# =============================================================================
# Gemini model for combined transcription + analysis
# Use through your LiteLLM proxy
GEMINI_MODEL=vertex_ai/gemini-2.0-flash
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
