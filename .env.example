# =============================================================================
# Azure Mode (speechai command)
# =============================================================================
# Azure Speech Service (from Azure AI Foundry)
AZURE_SPEECH_KEY=your_subscription_key_here
AZURE_SPEECH_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_TRANSLATOR_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_TRANSLATOR_KEY=your_subscription_key_here
# LiteLLM Configuration
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-1234

# =============================================================================
# Per-Agent Model Configuration (optional overrides)
# =============================================================================
# Each agent has a default model optimized for its task.
# Override any agent's model using LITELLM_MODEL_{AGENT_NAME}
#
# Defaults:
#   - sentiment, persona, product, competition → gpt-5-mini (reliable JSON)
#   - sales_prompts, consolidator → claude-haiku-4-5 (best tone)
#
# Available models (examples):
#   - gpt-5-mini          (Best for JSON output)
#   - gemini-2.5-flash-lite (Best context, cost-effective)
#   - deepseek-v3.1       (Best reasoning, cost-effective)
#   - claude-haiku-4-5    (Best conversational tone)
#
# LITELLM_MODEL_SENTIMENT=gpt-5-mini
# LITELLM_MODEL_PERSONA=gpt-5-mini
# LITELLM_MODEL_PRODUCT=gpt-5-mini
# LITELLM_MODEL_COMPETITION=gpt-5-mini
# LITELLM_MODEL_SALES_PROMPTS=claude-haiku-4-5
# LITELLM_MODEL_CONSOLIDATOR=claude-haiku-4-5

# =============================================================================
# Gemini Mode (speechai-gemini command)
# =============================================================================
# Gemini model for combined transcription + analysis
# Use through your LiteLLM proxy
# GEMINI_MODEL=vertex_ai/gemini-2.0-flash
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# SPEECHAI_DEBUG=false
